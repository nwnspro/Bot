{
  "manifest_version": 3,
  "name": "Vocab Bot",
  "version": "1.0",
  "description": "Send words from any webpage to your Discord vocabulary bot.",
  "permissions": ["contextMenus", "storage", "notifications"],
  "host_permissions": ["http://localhost:3001/*", "https://*.up.railway.app/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vocab Bot",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    { "resources": ["study.html", "wordlist.html"], "matches": ["<all_urls>"] }
  ]
}
